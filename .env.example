# ===== 필수 =====
# MongoDB Atlas 연결 문자열 (Database > Connect > Drivers 에서 복사, <password> 와 DB 이름 수정)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/webweb?retryWrites=true&w=majority
# 로그인 토큰 서명용 비밀키 (길고 무작위한 문자열, 예: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=production

# ===== 관리자 =====
# 이 아이디는 일반 회원가입에서 예약어로 막히고, 서버가 처음 시작할 때 아래 비밀번호로 관리자 계정을 직접 만듭니다.
ADMIN_USERNAME=chanhui2837
ADMIN_INITIAL_PASSWORD=처음-로그인할-비밀번호-8자이상
ADMIN_NICKNAME=웹웹관리자

# ===== 이미지 저장소 (Render 배포 시 필수) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=webweb

# ===== 아이디/비밀번호 찾기 인증번호 발송 (선택, 하나 이상 권장) =====
# 이메일 (Gmail 은 앱 비밀번호 사용: smtp.gmail.com / 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=웹웹 <no-reply@example.com>
# 문자 (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== 기타 (보통 수정할 필요 없음) =====
# PORT 는 Render 가 자동으로 넣어 줍니다. 로컬 기본값 4000
# PORT=4000
JWT_EXPIRES_DAYS=14
TRUST_PROXY=1
